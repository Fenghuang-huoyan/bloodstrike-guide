---
/**
 * Interactive Strike Pass 520 Gold Refund & Season Budget Calculator.
 */
import { monetizationConfig } from '@site/monetization.config';
const affUrl = monetizationConfig.lootbarAffiliateUrl.trim();
---
<section class="gold-calc" aria-label="Strike Pass Gold Refund Calculator">
  <div class="calc-head">
    <div class="calc-head-top">
      <span class="calc-tag">
        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="14" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/></svg>
        Interactive Season Planner
      </span>
      <div class="calc-presets" role="group" aria-label="Quick Gold balance presets">
        <button type="button" class="preset-chip" data-gold-preset="0">0g Fresh</button>
        <button type="button" class="preset-chip is-active" data-gold-preset="520">520g (1 Pass)</button>
        <button type="button" class="preset-chip" data-gold-preset="1040">1,040g</button>
        <button type="button" class="preset-chip" data-gold-preset="2180">2,180g</button>
      </div>
    </div>
    <h3>Strike Pass 520 Gold Refund Planner</h3>
    <p>
      The official 10 Nov 2026 update confirms the <strong>Graffiti Artist Strike Pass</strong> refunds up to <strong>520 Gold</strong> at max level. Simulate how many seasons your Gold balance sustains:
    </p>
  </div>

  <div class="calc-grid">
    <label class="calc-field" for="bs-starting-gold">
      <span>Starting Gold Balance</span>
      <input id="bs-starting-gold" type="number" inputmode="numeric" min="0" max="50000" step="10" value="520" />
    </label>
    <label class="calc-field" for="bs-seasons">
      <span>Planned Seasons Completed</span>
      <select id="bs-seasons">
        <option value="1">1 Season</option>
        <option value="2">2 Seasons</option>
        <option value="3" selected>3 Seasons</option>
        <option value="5">5 Seasons</option>
      </select>
    </label>
    <label class="calc-field" for="bs-extra-spend">
      <span>Extra Shop Spend / Season (Gold)</span>
      <input id="bs-extra-spend" type="number" inputmode="numeric" min="0" max="10000" step="10" value="0" />
    </label>
  </div>

  <div class="calc-result" id="bs-calc-result" role="status" aria-live="polite" aria-atomic="true">
    <div class="res-stat status-ok" id="bs-status-box">
      <span class="res-label">Pass Unlock Status</span>
      <strong id="bs-unlock-status">Self-Sustaining (520+ Gold)</strong>
    </div>
    <div class="res-stat">
      <span class="res-label">Cumulative Gold Refunded</span>
      <strong id="bs-total-refund">1,560 Gold</strong>
    </div>
    <div class="res-stat" id="bs-needed-box">
      <span class="res-label">Additional Top-Up Needed</span>
      <strong id="bs-gold-needed">0 Gold</strong>
    </div>
  </div>

  {affUrl && (
    <div id="bs-calc-cta" style="display:none; margin-top:0.85rem;">
      <a
        href={affUrl}
        target="_blank"
        rel="sponsored noopener"
        data-aff-partner="lootbar"
        data-aff-placement="gold_pass_calculator_shortfall"
        style="display:inline-flex; align-items:center; justify-content:center; gap:0.45rem; width:100%; min-height:44px; padding:0.6rem 1rem; border-radius:9px; background:#e11d48; color:#fff; font-weight:700; font-size:0.88rem; text-decoration:none; border:1px solid #f43f5e;"
      >
        <span id="bs-calc-cta-label">Top Up Missing Gold on LootBar (UID Only) →</span>
      </a>
    </div>
  )}
</section>

<script is:inline>
  (function () {
    const PASS_REFUND = 520;
    const startInput = document.getElementById('bs-starting-gold');
    const seasonsSelect = document.getElementById('bs-seasons');
    const extraInput = document.getElementById('bs-extra-spend');
    const statusEl = document.getElementById('bs-unlock-status');
    const statusBox = document.getElementById('bs-status-box');
    const neededBox = document.getElementById('bs-needed-box');
    const refundEl = document.getElementById('bs-total-refund');
    const neededEl = document.getElementById('bs-gold-needed');
    const ctaWrap = document.getElementById('bs-calc-cta');
    const ctaLabel = document.getElementById('bs-calc-cta-label');
    const presetBtns = document.querySelectorAll('[data-gold-preset]');

    function syncPresetActive(val) {
      presetBtns.forEach((btn) => {
        btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-gold-preset'), 10) === val);
      });
    }

    function update() {
      if (!startInput || !seasonsSelect || !extraInput) return;
      const start = Math.min(500000, Math.max(0, parseInt(startInput.value || '0', 10) || 0));
      const seasons = Math.max(1, parseInt(seasonsSelect.value || '1', 10) || 1);
      const extra = Math.min(100000, Math.max(0, parseInt(extraInput.value || '0', 10) || 0));

      const firstPassShortfall = Math.max(0, PASS_REFUND - start);
      const totalExtra = extra * seasons;
      const leftoverAfterFirst = Math.max(0, start - PASS_REFUND);
      const netNeeded = firstPassShortfall + Math.max(0, totalExtra - leftoverAfterFirst);
      const totalRefunded = PASS_REFUND * seasons;

      const isSelfSustaining = netNeeded === 0 && start >= PASS_REFUND;
      statusEl.textContent = isSelfSustaining
        ? 'Self-Sustaining (0 Top-Up Needed)'
        : ('Top-Up Needed (+' + netNeeded.toLocaleString('en-US') + ' Gold)');
      refundEl.textContent = totalRefunded.toLocaleString('en-US') + ' Gold';
      neededEl.textContent = netNeeded.toLocaleString('en-US') + ' Gold';

      if (statusBox) {
        statusBox.className = 'res-stat ' + (isSelfSustaining ? 'status-ok' : 'status-warn');
      }
      if (neededBox) {
        neededBox.className = 'res-stat ' + (isSelfSustaining ? '' : 'status-warn');
      }
      if (ctaWrap) {
        ctaWrap.style.display = netNeeded > 0 ? 'block' : 'none';
      }
      if (ctaLabel && netNeeded > 0) {
        ctaLabel.textContent = 'Top Up ' + netNeeded.toLocaleString('en-US') + '+ Gold via UID on LootBar →';
      }
      syncPresetActive(start);
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        startInput.value = btn.getAttribute('data-gold-preset') || '520';
        update();
      });
    });

    [startInput, seasonsSelect, extraInput].forEach((el) => {
      if (el) el.addEventListener('input', update);
      if (el) el.addEventListener('change', update);
    });
    update();
  })();
</script>

<style>
  .gold-calc {
    margin: 1.15rem 0 1.5rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 12px;
    background: linear-gradient(180deg, #11161f 0%, #0c1017 100%);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    max-width: 100%;
  }
  .calc-head-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .calc-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    background: rgba(225, 29, 72, 0.16);
    color: #fda4af;
    border: 1px solid rgba(244, 63, 94, 0.3);
  }
  .calc-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .preset-chip {
    min-height: 2rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }
  .preset-chip:hover {
    background: rgba(225, 29, 72, 0.14);
    border-color: rgba(244, 63, 94, 0.45);
    color: #ffffff;
  }
  .preset-chip.is-active {
    background: #e11d48;
    border-color: #f43f5e;
    color: #ffffff;
  }
  .calc-head h3 {
    margin: 0 0 0.3rem;
    font-size: 1.12rem;
    color: #ffffff;
  }
  .calc-head p {
    margin: 0 0 0.95rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #cbd5e1;
  }
  .calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.95rem;
  }
  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #e2e8f0;
    min-width: 0;
  }
  .calc-field input,
  .calc-field select {
    width: 100%;
    min-height: 2.75rem;
    box-sizing: border-box;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.32);
    background: #080b10;
    color: #f8fafc;
    font-size: 0.94rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .calc-field input:focus,
  .calc-field select:focus {
    border-color: #f43f5e;
    box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.22);
    outline: none;
  }
  .calc-result {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.65rem;
  }
  .res-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 0.85rem;
    border-radius: 9px;
    background: rgba(21, 27, 36, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-left: 3px solid #64748b;
  }
  .res-stat.status-ok {
    border-left-color: #10b981;
    background: rgba(16, 185, 129, 0.08);
  }
  .res-stat.status-ok strong {
    color: #34d399;
  }
  .res-stat.status-warn {
    border-left-color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
  }
  .res-stat.status-warn strong {
    color: #fbbf24;
  }
  .res-label {
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }
  .res-stat strong {
    font-size: 1.02rem;
    color: #f8fafc;
    font-variant-numeric: tabular-nums;
  }
</style>
